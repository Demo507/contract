# Supabase: use the SESSION POOLER connection string (IPv4 friendly), not the direct db.xxx.supabase.co one
DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ESCROW_ADDRESS=0xB13b99fDAB66beDB79a1987e9f68267beb42B6Ab
TCH8_ADDRESS=0x40e1cD143C5576610AF78bf5cF1da0C47Bbeb977

# Wallet that is set as Escrow.operator (keep a little Sepolia ETH in it for gas)
OPERATOR_PRIVATE_KEY=0xYOUR_OPERATOR_PRIVATE_KEY

# Admin wallet allowed to VIEW complaints
OPERATOR_WALLET=0xYourAdminWalletAddress

# Long random secret that protects payout buttons. Make one up.
ADMIN_KEY=change-me-to-a-long-random-string

# Your Vercel site, so only it can call this API (optional but recommended)
FRONTEND_URL=https://your-app.vercel.app

PORT=4000
