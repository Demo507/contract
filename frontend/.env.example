# Your Render backend URL (no trailing slash). For local testing use http://localhost:4000
VITE_BACKEND_URL=https://your-backend.onrender.com

# Free Project ID from https://cloud.walletconnect.com (needed for the "Mobile wallet" login)
VITE_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# Your Alchemy Sepolia URL (stops the public RPC from rate-limiting you)
VITE_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# The admin wallet that should see the Admin dashboard (same as backend OPERATOR_WALLET)
VITE_OPERATOR_ADDRESS=0xYourAdminWalletAddress

# Optional overrides (defaults are your deployed Sepolia contracts)
# VITE_ESCROW_ADDRESS=0xB13b99fDAB66beDB79a1987e9f68267beb42B6Ab
# VITE_SALE_ADDRESS=0x72F8C939BBB4022Fd8cB233b5Fb69513198fE55e
